# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a git.

# --- Base de datos (elige UNA de las dos formas) ---
# Forma 1: URL completa (si la defines, se ignoran las POSTGRES_*)
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/basedatos?sslmode=require

# Forma 2: piezas sueltas (la contraseña puede tener caracteres especiales sin codificar)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=polla
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=polla
# Para un servidor remoto suele hacer falta: require
POSTGRES_SSLMODE=
# Esquema donde se crean las tablas (se crea solo). Usa "public" para el de siempre
DATABASE_SCHEMA=polla_futbolera

# --- App ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60
# fake | api_football
RESULTS_PROVIDER=fake
API_FOOTBALL_KEY=
# Temporada a consultar (ej. 2025); vacío = se deduce sola
API_FOOTBALL_SEASON=
# true para que la API arranque los jobs automáticos (sync de partidos y puntos)
SCHEDULER_ENABLED=false
# Cada cuántos minutos se consultan los resultados de partidos en juego (1-60).
# Con el plan gratis de API-Football (100 llamadas/día) conviene 10 o más.
SETTLE_INTERVAL_MINUTES=5
# Orígenes del frontend web permitidos (CORS), separados por coma. Ej. en desarrollo:
# CORS_ORIGINS=http://localhost:5000,http://localhost:8080
CORS_ORIGINS=
