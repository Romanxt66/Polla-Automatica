# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a git.

# --- Base de datos (elige UNA de las dos formas) ---
# Forma 1: URL completa (si la defines, se ignoran las POSTGRES_*)
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/basedatos?sslmode=require

# Forma 2: piezas sueltas (la contraseña puede tener caracteres especiales sin codificar)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=polla
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=polla
# Para un servidor remoto suele hacer falta: require
POSTGRES_SSLMODE=

# --- App ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60
# fake | api_football
RESULTS_PROVIDER=fake
API_FOOTBALL_KEY=
# Temporada a consultar (ej. 2025); vacío = se deduce sola
API_FOOTBALL_SEASON=
# true para que la API arranque los jobs automáticos (sync de partidos y puntos)
SCHEDULER_ENABLED=false
